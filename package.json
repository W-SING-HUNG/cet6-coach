{
  "name": "cet6-prep",
  "version": "0.1.0",
  "private": true,
  "description": "CET-6 Coach — a local-first study coach for CET-6 preparation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev -H 127.0.0.1 -p 3100",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start -H 127.0.0.1 -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "telemetry:status": "node scripts/next.mjs telemetry status",
    "telemetry:proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/telemetry-clean-env-proof.ts",
    "next:import-safety": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/next-import-safety-proof.ts",
    "icons": "node scripts/generate-icons.mjs",
    "verify:flow": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/verify-flow.ts",
    "content:validate": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/content-validate.ts",
    "content:import": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/content-import.ts",
    "course:validate": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-validate.ts",
    "course:extract": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-extract.ts",
    "course:segment": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-segment.ts",
    "course:workbench": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-workbench.ts",
    "course:adjudication": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-adjudication.ts",
    "course:a2-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a2-proof.ts",
    "course:a2-mutation": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a2-mutation.ts",
    "course:a3": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a3.ts",
    "course:a3-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a3-proof.ts",
    "course:a3-mutation": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a3-mutation.ts",
    "course:recover": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-recover.ts",
    "course:recover-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-recover-proof.ts",
    "course:a1-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a1-workbench-proof.ts",
    "course:a1-acceptance": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-a1-owner-acceptance.ts",
    "course:segment-smoke": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-segment-smoke.ts",
    "course:segment-mutation": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-segmentation-plan-mutation.ts",
    "course:segment-plan-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-segmentation-plan-proof.ts",
    "course:review": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-review.ts",
    "course:demo-package": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-demo-package.ts",
    "course:import": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-import.ts",
    "course:link": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-link.ts",
    "course:review-repro": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-review-repro.ts",
    "course:cli-readonly-proof": "node scripts/course-cli-readonly-proof.mjs",
    "course:intake-repro": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-intake-repro.ts",
    "course:intake-e2e": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-intake-e2e.ts",
    "course:handoff-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-intake-handoff-proof.ts",
    "course:path-safety-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-path-safety-proof.ts",
    "freshness:mutation": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/paper-freshness-mutation.ts",
    "companion:mutation": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/course-companion-mutation.ts",
    "e2e:privacy-mutation": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/e2e-privacy-mutation.ts",
    "e2e:loopback-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/e2e-loopback-binding-proof.ts",
    "papers:extract": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/papers-extract.ts",
    "papers:review": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/papers-review.ts",
    "e2e": "playwright test",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:desktop": "playwright test --project=desktop",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:ci && pnpm build && pnpm release:check && pnpm release:license-controls && pnpm release:workspace-paths && pnpm release:docs && pnpm release:archive && pnpm release:objects",
    "content:fingerprint-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/content-fingerprint-proof.ts",
    "content:audit-files": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/audit-files.ts",
    "display-safety-proof": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/display-safety-proof.ts",
    "release:check": "node tools/public-release-check.mjs",
    "release:notices": "node tools/dependency-notices.mjs",
    "release:docs": "node tools/check-doc-references.mjs",
    "release:deps": "node tools/check-dependency-security.mjs",
    "release:deps-controls": "node tools/dependency-security-controls.mjs",
    "release:workflow": "node tools/check-workflow-integrity.mjs",
    "release:workflow-controls": "node tools/workflow-integrity-controls.mjs",
    "test:ci": "vitest run --maxWorkers=4",
    "release:history": "node tools/audit-history.mjs",
    "release:secrets": "node --experimental-transform-types tools/secret-scan-controls.mjs",
    "release:fingerprints": "node --experimental-transform-types tools/check-exam-fingerprints.mjs",
    "release:bundle": "node tools/check-client-bundle.mjs",
    "smoke": "node tools/smoke-test.mjs",
    "release:archive": "node tools/check-release-archive.mjs",
    "verify:scanner": "node tools/structural-scan.mjs && node tools/probe-markdown-comments.mjs",
    "verify:guards": "pnpm verify:scanner && node tools/guard-token-scanner.mjs && node tools/guard-build-boundary.mjs && node tools/guard-source-doc-refs.mjs && node tools/guard-role-references.mjs",
    "release:objects": "node tools/audit-object-database.mjs",
    "release:workspace-paths": "node tools/workspace-path-controls.mjs",
    "release:license-controls": "node tools/license-check-controls.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
