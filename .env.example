# CET-6 Coach — configuration template
#
# Copy to `.env.local` (git-ignored) and edit only what you need.
# Every value below has a working default; an empty file is a valid setup.
#
# This application makes no outbound network calls at runtime and has no
# accounts. There are no secrets to configure.

# ---------------------------------------------------------------------------
# Where your study content lives.
# This directory is git-ignored and must never be committed.
# Layout: <root>/cet6/papers/<package>/paper.json  and  <root>/courses/<id>/course.json
# See docs/past-paper-package.md and docs/course-package.md.
# ---------------------------------------------------------------------------
CET6_CONTENT_ROOT=./private-content

# ---------------------------------------------------------------------------
# SQLite database file. Created on first run. Git-ignored.
# ---------------------------------------------------------------------------
CET6_DB_PATH=./data/cet6.db

# ---------------------------------------------------------------------------
# The exact origin trusted for same-origin POST checks.
# `127.0.0.1` and `localhost` are DIFFERENT origins and are not interchangeable;
# the browser will only complete a state-changing request from the one configured
# here. The default is the canonical address, so leave this unset unless you
# really do open the app under a different name, and then open exactly that name.
# Leave unset to derive it from the listening port.
# ---------------------------------------------------------------------------
# CET6_LOCAL_ORIGIN=http://127.0.0.1:3100

# ---------------------------------------------------------------------------
# HTTP port. The dev server script pins 3100 by default.
# ---------------------------------------------------------------------------
# PORT=3100

# ---------------------------------------------------------------------------
# Reserved for a future hosted AI provider.
#
# Nothing in the current codebase reads this value. There is no AI provider
# registered beyond the deterministic local stub, and the UI labels the stub's
# output as such. Leave it unset.
# ---------------------------------------------------------------------------
# AI_API_KEY=

# ---------------------------------------------------------------------------
# Test-only variables. Do NOT set these in normal use.
# They exist so the E2E launchers can build isolated instances.
# ---------------------------------------------------------------------------
# E2E_RESET_DB=1
# LEGACY_MODE=eligible
# CET6_REAL_BASE_URL=http://127.0.0.1:3210
